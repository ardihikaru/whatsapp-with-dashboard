# The SQLite file holds WhatsApp cryptographic identity material (whatsmeow
# keys) — treat it like a credential, never commit it. See README § Backup.
*.db
*.db-wal
*.db-shm
*.db-journal

_data/*

# Local env: MySQL and admin credentials.
#
# The glob matters as much as the literal name. A `.env.bak.<timestamp>` from
# an in-place edit (sed -i.bak and friends) is a byte-for-byte copy of every
# secret in .env, and with only `.env` listed here `git add -A` picks it up
# without a murmur. Keep .env.example tracked; ignore every other sibling.
.env
.env.*
!.env.example
# Same exception, same reasoning, for the deploy bundle's template: it ships
# every key this deployment reads with EMPTY values, and it is the only copy
# of that list on a host with no repo. `.env.*` above catches it by accident,
# which would make TestPHKGBundleIsComplete and
# TestPHKGEnvTemplateScopesTheMinioTempBucket fail on a fresh clone against a
# file git never took. Safe to track because
# TestPHKGEnvTemplateCarriesNoSecretValues fails the build if any
# PASSWORD/SECRET/TOKEN/ACCESS_KEY line in it ever carries a value.
!deploy/phkg/.env.template

# Compiled binary / local bind-mount data.
/wsm
/data/

# Playwright: the browser harness, its installs and its output. The specs in
# e2e/ and the config ARE tracked; everything a run produces is not.
/node_modules/
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/.auth/

# E2E screenshots: 8.6MB of regenerable binaries. The evidence LOG
# (docs/e2e-evidence.md) is tracked; the images it describes are reproduced on
# demand with `make e2e-evidence`, rather than living forever in git history.
/docs/e2e-evidence/*.png

# Image tarballs saved from a production host on their way to another one.
# Big, and a copy of a production artefact — never part of the repo.
_transfer/
