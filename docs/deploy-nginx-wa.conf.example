# whatsapp-with-dashboard — L7 edge on the public box. TLS ends here; the hop to
# the private VM is plain HTTP over WireGuard. Install as /etc/nginx/conf.d/wa.conf.
#
# THIS EDGE IS SHARED with several other products. Two consequences that are easy to get
# wrong and expensive to debug:
#
#   * `map` lives in nginx's http context and its variable names are GLOBAL across
#     everything in conf.d. Every variable here is prefixed `$wa_`. Renaming
#     them to something generic can collide with a neighbour and fail the reload for the
#     whole host, taking every other product down with it.
#   * No `default_server` anywhere in this file. Claiming it would silently steal every
#     unmatched hostname on the box.
#
# Always `sudo nginx -t` before `systemctl reload nginx`.
#
# Its own certificate lineage, so a neighbour's broken DNS can never block renewal here:
#   certbot certonly --webroot -w /var/www/acme --cert-name wa \
#     -d wa.mfardiansyah.id --deploy-hook 'nginx -t && systemctl reload nginx'

map $http_upgrade $wa_connection_upgrade { default upgrade; '' close; }

# Shared port register: 1<environment><product>1. whatsapp-with-dashboard owns slot 08.
# Prod only — there is no dev tier for this product, and 19801 is reserved for one.
map $host $wa_backend {
    hostnames;
    wa.mfardiansyah.id  10.10.0.4:18801;
    default             "";
}

server {
    listen 80;
    listen [::]:80;
    server_name wa.mfardiansyah.id;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wa.mfardiansyah.id;

    ssl_certificate     /etc/letsencrypt/live/wa/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wa/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # An empty map result means this vhost was reached for a host it does not serve.
    # 444 closes without a response rather than proxying to a blank upstream.
    if ($wa_backend = "") { return 444; }

    # THE JSON API HAS NO PUBLIC ROUTE. Its consumers dial the service directly
    # over WireGuard at 10.10.0.4:18801, so publishing /api/v1 here would widen
    # the attack surface of a WhatsApp identity to the whole internet and buy
    # nothing. `^~` beats the prefix match on `/` without needing a regex.
    #
    # /openapi.yaml is deliberately NOT blocked: the /docs page is behind the
    # admin login, but the browser fetches the spec from the ROOT (the API lives
    # there, unprefixed), so blocking it would render /docs empty. A description
    # of the API is not access to it.
    location ^~ /api/v1/ { return 404; }

    location / {
        proxy_pass http://$wa_backend;
        proxy_http_version 1.1;
        # X-Forwarded-For is what the app reads back to recover the real client
        # address, and $proxy_add_x_forwarded_for APPENDS to whatever the client
        # sent rather than trusting it. That only works because the app trusts
        # this hop specifically: WSM_TRUSTED_PROXIES=10.10.0.0/24 on the VM, and
        # it takes the RIGHTMOST untrusted entry. Without it every login attempt
        # on the box keys on this proxy's address and one attacker throttles
        # every user at once.
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Forwarded-Port   $server_port;
        proxy_set_header X-Forwarded-Proto  https;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header Upgrade            $http_upgrade;
        proxy_set_header Connection         $wa_connection_upgrade;
        # NOTHING IS STRIPPED. WA_BASE_URL has no path, so the service owns this
        # host's root end to end. A stripping proxy would pass every curl check
        # against the API and STILL break the login POST, because the login page
        # renders its form action from BasePath.
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
