# wsm-mcp environment. Copy to clinodb's ~/.config/wsm-mcp/mcp.env (chmod
# 600), fill in every value below, and NEVER commit the filled-in file.
# See mcp/README.md for the format and the operator's own copy of
# client.json (never in this repo either).

# Failover pool, priority order: "name=wsmBaseURL|waxumBaseURL,name2=...".
# wsmBaseURL is WSM's own root (health/sessions/messages/etc at /api/v1
# under it); waxumBaseURL is waxum's own root (no /api/v1 prefix).
WSM_MCP_HOSTS=minipc=http://10.10.0.4:18801|http://10.10.0.4:3451,laptop=http://10.10.0.3:18801|http://10.10.0.3:3451

# HTTP Basic credential wsm-mcp authenticates every WSM call with.
# api_clients rows are mirrored across both DBs, so one credential works on
# every configured host — see docs/auth-and-api-clients.md.
WSM_MCP_WSM_LOGIN_ID=wsm-mcp
WSM_MCP_WSM_SECRET=

# waxum's SUPERADMIN_TOKEN, shared by both waxum instances (see CLAUDE.md's
# "one certificate, six names" entry for why).
WSM_MCP_WAXUM_TOKEN=

# Default phone used when a session-scoped tool gets neither session_id
# nor phone.
WSM_MCP_DEFAULT_PHONE=6285132148259

# Refuses every Danger-gated tool unless "true". Leave unset/false unless
# you deliberately need a destructive tool available right now.
WSM_MCP_ALLOW_DANGEROUS=false

# Binds. On clinodb these are the WireGuard address, not loopback — see
# deploy/clinodb/README.md.
WSM_MCP_GRPC_ADDR=10.10.0.5:18811
WSM_MCP_HTTP_ADDR=10.10.0.5:18812

# Basic credential the two front doors require from every CALLER of
# wsm-mcp itself (distinct from WSM_MCP_WSM_* above, which is wsm-mcp's own
# credential INTO WSM). Generate the password with
# python3 -c "import secrets;print(secrets.token_urlsafe(32))" — at least
# 16 chars, basicauth.New refuses anything shorter.
WSM_MCP_BASIC_USER=wsm-mcp
WSM_MCP_BASIC_PASS=

# Per-request body cap. 1 MiB covers every tool except base64 media
# arguments; raise only as far as the largest file you actually send.
WSM_MCP_MAX_BODY_BYTES=146800640
