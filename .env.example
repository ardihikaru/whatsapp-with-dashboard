# whatsapp-with-dashboard — copy to .env and fill in. .env IS GITIGNORED.
#
# ┌─ TWO MODES, ONE FILE ────────────────────────────────────────────────────┐
# │ HOST MODE       `make run` / `go run ./cmd/app` / `make migrate-up`      │
# │                 -> MySQL at 127.0.0.1:5306, master-compose-ai's          │
# │                    published port. THE VALUES BELOW ARE HOST-MODE.       │
# │ CONTAINER MODE  `make up` / `docker compose up -d`                       │
# │                 -> MySQL at mysqldb-master:3306 over container DNS.      │
# │                    docker-compose.yml OVERRIDES WSM_MYSQL_HOST/PORT and  │
# │                    WSM_DB_PATH for you. DO NOT edit them for that.       │
# └──────────────────────────────────────────────────────────────────────────┘

# ── HTTP ───────────────────────────────────────────────────────────────────
WSM_ADDR=:8800
# Host port published in container mode.
WSM_EXPOSED_PORT=8800
# Host ADDRESS published in container mode. 127.0.0.1 keeps the dashboard off
# every network this box is on, which is the right default for an admin surface
# with a WhatsApp identity behind it.
#
# Change it ONLY when a TLS reverse proxy fronts this service, and then to the
# single interface that proxy reaches you on (a WireGuard address, say) --
# never 0.0.0.0. Pair it with WA_COOKIE_SECURE=true and WSM_TRUSTED_PROXIES.
WSM_BIND_ADDR=127.0.0.1
# Public base URL. The BROWSER surface is mounted under this URL's PATH
# (http://localhost:8800 -> mounted at the root; https://host/wa -> at /wa).
# The JSON API always stays at the root, unprefixed. Must be absolute, with no
# query or fragment — the app refuses to boot otherwise.
WA_BASE_URL=http://localhost:8800
# true behind HTTPS. Leaving it false behind TLS means the session cookie
# survives a downgrade to plaintext.
WA_COOKIE_SECURE=false
# Sidebar back-link to a parent app. EMPTY = hide the link entirely (the code
# uses LookupEnv here, so "" is meaningful, not merely "unset").
WA_PLATFORM_URL=

# Comma-separated CIDRs / bare IPs whose X-Forwarded-For this app will believe.
# EMPTY (the default) means it believes nobody and reads the connecting address
# only -- unspoofable, and correct for a direct listener.
#
# The login and API throttles key on that address. Behind a reverse proxy every
# request arrives FROM THE PROXY, so without this one attacker's failures spend
# the throttle budget for every user at once. Naming the proxy restores
# per-client keying.
#
# Name only proxies that OVERWRITE the header -- nginx's
# `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for` does. Trusting
# one that merely forwards a client's own header is the same as having no
# throttle at all, because the client then picks its own key.
#WSM_TRUSTED_PROXIES=10.10.0.0/24

# ── Local admin login (replaces the platform SSO this app was forked from) ──
WSM_ADMIN_USER=admin
# REQUIRED. Generate with:  make hashpw  (it prints the finished line to paste)
#
# KEEP THE SINGLE QUOTES. A bcrypt hash starts "$2a$10$..." and every reader of
# this file eats bare dollars: make expands $2/$1 while exporting, and `.` in a
# POSIX shell expands them as positional parameters. Single quotes survive make,
# the shell and docker compose's env_file parser alike.
#
# The app refuses to boot with neither this nor WSM_ADMIN_PASSWORD set — a
# default admin password on a service holding a WhatsApp identity is an account
# takeover waiting for someone to port-forward it.
WSM_ADMIN_PASSWORD_HASH=''
# Dev-only fallback: plaintext, hashed once at boot, logs a warning. Prefer the
# hash above — plaintext here shows up in `docker inspect` and in crash dumps.
#WSM_ADMIN_PASSWORD=

# ── MySQL app store (master-compose-ai) ────────────────────────────────────
# Container: master-compose-ai-mysqldb-master-1 (mysql:8.0.33), 5306 -> 3306.
# Bootstrap the DB and user once with `make db-bootstrap`.
WSM_MYSQL_HOST=127.0.0.1
WSM_MYSQL_PORT=5306
WSM_MYSQL_DATABASE=wa_dashboard
WSM_MYSQL_USER=wa_dashboard
# Generate with:  openssl rand -hex 12
# HEX ONLY, PLEASE. `make db-bootstrap` sed-substitutes this into
# scripts/bootstrap-db.sql.tmpl, so a / & or # in here would corrupt the SQL.
WSM_MYSQL_PASSWORD=

# Full DSN override. Wins VERBATIM over every WSM_MYSQL_* above.
# LEAVE THIS COMMENTED OUT unless you know why you want it: a host-mode DSN here
# would break container mode (docker-compose.yml blanks it defensively).
#WSM_APP_DSN=user:pass@tcp(127.0.0.1:5306)/wa_dashboard?parseTime=true&charset=utf8mb4&loc=UTC
#
# DEV / E2E ONLY — a "sqlite:" prefix puts the APP tables in a local SQLite file
# instead of MySQL, so the binary boots with no database server reachable at
# all. internal/db.OpenAppStore takes this branch and creates the schema with
# EnsureSchema; the app logs a WARNING every boot so it can never be mistaken
# for a production setting.
#
# NEVER set this in production: goose owns the MySQL schema, EnsureSchema is a
# second hand-maintained copy in SQLite dialect, and nothing keeps the two in
# step. `make e2e` sets it for you (scripts/e2e-env.sh) and points it at a
# throwaway file, precisely so the browser tests never touch the SHARED
# production MySQL.
#WSM_APP_DSN=sqlite:./_data/e2e/app.db

# Root password of the SHARED stack. Used ONLY by `make db-bootstrap` and
# `make db-drop`; the app itself NEVER connects as root.
# Copy from /home/ardi/devel/projects/master-compose-ai/.env
MYSQL_ROOT_PASSWORD=
MYSQL_CONTAINER=master-compose-ai-mysqldb-master-1

# ── SQLite whatsmeow store ─────────────────────────────────────────────────
# CRYPTOGRAPHIC IDENTITY MATERIAL. Gitignored; back it up like a credential, and
# never run two processes against one file (WhatsApp will log the device out).
# Host mode: a file in the working directory. Container mode: /data/wsm.db on
# the whatsapp-with-dashboard-sqlite volume (set by docker-compose.yml).
WSM_DB_PATH=wsm-store.db
# modernc.org/sqlite (pure Go). "sqlite" is the ONLY accepted value — the
# mattn/CGO driver is not compiled in, and internal/db.Open rejects anything else.
WSM_SQLITE_DIALECT=sqlite

# ── Behaviour ──────────────────────────────────────────────────────────────
WSM_SESSION_TTL=12h
WSM_SEND_RATE=1.0
WSM_SEND_BURST=3
WSM_RECONCILE_PAR=4
WSM_DARK_MODE=true

# ── MinIO object storage ────────────────────────────────────────────────────
# REQUIRED: the app fails to boot without a working connection. There is no
# consuming feature yet — this exists so a misconfigured connection fails
# loudly here, not the first time something tries to use it.
#
# Full URL, scheme required (http:// or https://). The scheme also decides
# whether the client talks TLS to it.
WSM_MINIO_ENDPOINT=https://minio.example.com
WSM_MINIO_ACCESS_KEY=
WSM_MINIO_SECRET_KEY=
# Created automatically at boot if it doesn't exist yet.
WSM_MINIO_BUCKET=
# Scratch space for in-progress uploads. Created automatically too.
WSM_MINIO_TEMP_BUCKET=temp
# Go duration syntax (time.ParseDuration). Bounds the boot-time connectivity
# check; defaults to 30s if unset.
#WSM_MINIO_TIMEOUT=100s
# How long a presigned URL stays valid. Not consumed by any feature yet —
# reserved for when one needs it. Defaults to 168h (7 days) if unset.
#WSM_MINIO_SHARE_DURATION=168h
