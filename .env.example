# whatsapp-with-dashboard — copy to .env and fill in. .env IS GITIGNORED.
#
# ┌─ TWO MODES, ONE FILE ────────────────────────────────────────────────────┐
# │ HOST MODE       `make run` / `go run ./cmd/app` / `make migrate-up`      │
# │                 -> MySQL at 127.0.0.1:5306, master-compose-ai's          │
# │                    published port. THE VALUES BELOW ARE HOST-MODE.       │
# │ CONTAINER MODE  `make up` / `docker compose up -d`                       │
# │                 -> MySQL at mysqldb-master:3306 over container DNS.      │
# │                    docker-compose.yml OVERRIDES WSM_MYSQL_HOST/PORT and  │
# │                    WSM_DB_PATH for you. DO NOT edit them for that.       │
# └──────────────────────────────────────────────────────────────────────────┘

# ── HTTP ───────────────────────────────────────────────────────────────────
WSM_ADDR=:8800
# Host port published in container mode.
WSM_EXPOSED_PORT=8800
# Host ADDRESS published in container mode. 127.0.0.1 keeps the dashboard off
# every network this box is on, which is the right default for an admin surface
# with a WhatsApp identity behind it.
#
# Change it ONLY when a TLS reverse proxy fronts this service, and then to the
# single interface that proxy reaches you on (a WireGuard address, say) --
# never 0.0.0.0. Pair it with WA_COOKIE_SECURE=true and WSM_TRUSTED_PROXIES.
WSM_BIND_ADDR=127.0.0.1
# Public base URL. The BROWSER surface is mounted under this URL's PATH
# (http://localhost:8800 -> mounted at the root; https://host/wa -> at /wa).
# The JSON API always stays at the root, unprefixed. Must be absolute, with no
# query or fragment — the app refuses to boot otherwise.
WA_BASE_URL=http://localhost:8800
# true behind HTTPS. Leaving it false behind TLS means the session cookie
# survives a downgrade to plaintext.
WA_COOKIE_SECURE=false
# Sidebar back-link to a parent app. EMPTY = hide the link entirely (the code
# uses LookupEnv here, so "" is meaningful, not merely "unset").
WA_PLATFORM_URL=

# Comma-separated CIDRs / bare IPs whose X-Forwarded-For this app will believe.
# EMPTY (the default) means it believes nobody and reads the connecting address
# only -- unspoofable, and correct for a direct listener.
#
# The login and API throttles key on that address. Behind a reverse proxy every
# request arrives FROM THE PROXY, so without this one attacker's failures spend
# the throttle budget for every user at once. Naming the proxy restores
# per-client keying.
#
# Name only proxies that OVERWRITE the header -- nginx's
# `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for` does. Trusting
# one that merely forwards a client's own header is the same as having no
# throttle at all, because the client then picks its own key.
#WSM_TRUSTED_PROXIES=10.10.0.0/24

# ── Local admin login (replaces the platform SSO this app was forked from) ──
WSM_ADMIN_USER=admin
# REQUIRED. Generate with:  make hashpw  (it prints the finished line to paste)
#
# KEEP THE SINGLE QUOTES. A bcrypt hash starts "$2a$10$..." and every reader of
# this file eats bare dollars: make expands $2/$1 while exporting, and `.` in a
# POSIX shell expands them as positional parameters. Single quotes survive make,
# the shell and docker compose's env_file parser alike.
#
# The app refuses to boot with neither this nor WSM_ADMIN_PASSWORD set — a
# default admin password on a service holding a WhatsApp identity is an account
# takeover waiting for someone to port-forward it.
WSM_ADMIN_PASSWORD_HASH=''
# Dev-only fallback: plaintext, hashed once at boot, logs a warning. Prefer the
# hash above — plaintext here shows up in `docker inspect` and in crash dumps.
#WSM_ADMIN_PASSWORD=

# ── MySQL app store (master-compose-ai) ────────────────────────────────────
# Container: master-compose-ai-mysqldb-master-1 (mysql:8.0.33), 5306 -> 3306.
# Bootstrap the DB and user once with `make db-bootstrap`.
WSM_MYSQL_HOST=127.0.0.1
WSM_MYSQL_PORT=5306
WSM_MYSQL_DATABASE=wa_dashboard
WSM_MYSQL_USER=wa_dashboard
# Generate with:  openssl rand -hex 12
# HEX ONLY, PLEASE. `make db-bootstrap` sed-substitutes this into
# scripts/bootstrap-db.sql.tmpl, so a / & or # in here would corrupt the SQL.
WSM_MYSQL_PASSWORD=

# Full DSN override. Wins VERBATIM over every WSM_MYSQL_* above.
# LEAVE THIS COMMENTED OUT unless you know why you want it: a host-mode DSN here
# would break container mode (docker-compose.yml blanks it defensively).
#WSM_APP_DSN=user:pass@tcp(127.0.0.1:5306)/wa_dashboard?parseTime=true&charset=utf8mb4&loc=UTC
#
# DEV / E2E ONLY — a "sqlite:" prefix puts the APP tables in a local SQLite file
# instead of MySQL, so the binary boots with no database server reachable at
# all. internal/db.OpenAppStore takes this branch and creates the schema with
# EnsureSchema; the app logs a WARNING every boot so it can never be mistaken
# for a production setting.
#
# NEVER set this in production: goose owns the MySQL schema, EnsureSchema is a
# second hand-maintained copy in SQLite dialect, and nothing keeps the two in
# step. `make e2e` sets it for you (scripts/e2e-env.sh) and points it at a
# throwaway file, precisely so the browser tests never touch the SHARED
# production MySQL.
#WSM_APP_DSN=sqlite:./_data/e2e/app.db

# Root password of the SHARED stack. Used ONLY by the db-bootstrap/db-verify/
# db-drop family of `make` targets (over TCP at WSM_MYSQL_HOST:WSM_MYSQL_PORT,
# same as everything else below — never `docker exec`, see CLAUDE.md); the
# app itself NEVER connects as root.
# Copy from /home/ardi/devel/projects/master-compose-ai/.env
MYSQL_ROOT_PASSWORD=

# ── SQLite whatsmeow store ─────────────────────────────────────────────────
# CRYPTOGRAPHIC IDENTITY MATERIAL. Gitignored; back it up like a credential, and
# never run two processes against one file (WhatsApp will log the device out).
# Host mode: a file in the working directory. Container mode: /data/wsm.db on
# the whatsapp-with-dashboard-sqlite volume (set by docker-compose.yml).
WSM_DB_PATH=wsm-store.db
# modernc.org/sqlite (pure Go). "sqlite" is the ONLY accepted value — the
# mattn/CGO driver is not compiled in, and internal/db.Open rejects anything else.
WSM_SQLITE_DIALECT=sqlite

# ── Behaviour ──────────────────────────────────────────────────────────────
WSM_SESSION_TTL=12h
WSM_SEND_RATE=1.0
WSM_SEND_BURST=3
WSM_RECONCILE_PAR=4
WSM_DARK_MODE=true

# ── MinIO object storage ────────────────────────────────────────────────────
# REQUIRED: the app fails to boot without a working connection. Backs media
# archival (internal/storage.MinioObjects, threaded into handler.Deps.Objects)
# — this exists so a misconfigured connection fails loudly here, not the
# first time a media send tries to use it.
#
# Full URL, scheme required (http:// or https://). The scheme also decides
# whether the client talks TLS to it.
WSM_MINIO_ENDPOINT=https://minio.example.com
WSM_MINIO_ACCESS_KEY=
WSM_MINIO_SECRET_KEY=
# Created automatically at boot if it doesn't exist yet.
WSM_MINIO_BUCKET=
# Scratch space for in-progress uploads. Created automatically too.
WSM_MINIO_TEMP_BUCKET=temp
# Go duration syntax (time.ParseDuration). Bounds the boot-time connectivity
# check; defaults to 30s if unset.
#WSM_MINIO_TIMEOUT=100s
# How long a presigned URL stays valid. Consumed by
# internal/storage.MinioObjects.PresignedGet (media download links).
# Defaults to 168h (7 days) if unset.
#WSM_MINIO_SHARE_DURATION=168h

# ── Media send & voice calls (Phase 6a) ─────────────────────────────────────
# All optional, all resolve to a default — none of these is required for the
# app to boot, unlike the MinIO block above (scripts/e2e-env.sh exports none
# of them, so the e2e boot must not need them either).
#
# Request cap for one media upload (POST .../messages/media), enforced by
# http.MaxBytesReader BEFORE the multipart form is parsed — the ceiling no
# per-kind limit below may exceed. Bytes, no unit suffix. Defaults to
# 104857600 (100 MiB) if unset, matching waxum's own /media/upload route cap.
#WSM_MEDIA_MAX_BYTES=104857600
# Per-kind caps, each on top of (never above) WSM_MEDIA_MAX_BYTES above —
# WhatsApp's own media limits differ by kind, so one global number either
# under-restricts a document or over-permits a video past what WhatsApp will
# actually accept. Bytes, no unit suffix. These four defaults are WhatsApp's
# PUBLISHED limits (business.whatsapp.com's media specs) — published, not
# measured against this gateway. An explicit value above WSM_MEDIA_MAX_BYTES
# fails config load; an unset one is silently clamped down to it instead.
#WSM_MEDIA_MAX_BYTES_IMAGE=5242880
#WSM_MEDIA_MAX_BYTES_VIDEO=16777216
#WSM_MEDIA_MAX_BYTES_AUDIO=16777216
#WSM_MEDIA_MAX_BYTES_DOCUMENT=104857600
# The media handler's OWN timeout for the backend upload call
# (Manager.MediaStore().UploadMedia) — separate from and starting AFTER the
# 15s send-wait (send.go's sendWaitLimit). Go duration syntax. Defaults to
# 60s if unset.
#WSM_MEDIA_UPLOAD_TIMEOUT=60s
# How many media uploads may run at once — the memory ceiling
# sendQueueCap (internal/wa) does NOT provide, since an upload happens in the
# HTTP handler before a job is ever enqueued. Defaults to 4 if unset.
#WSM_MEDIA_UPLOAD_CONCURRENCY=4
# Turns the best-effort MinIO archive step (every media send, before the
# backend upload) on or off. "false" skips it entirely; waxum still holds its
# own copy after upload either way. Defaults to true if unset.
#WSM_MEDIA_ARCHIVE=true
# Gates every /api/v1/sessions/{id}/calls/* endpoint. "false" (the default)
# makes all of them answer 501 and place nothing — see CLAUDE.md's calls
# hazard note for why voice calling ships disarmed: WhatsApp's terms are
# hostile to automated outbound calling, and the paired device identity has
# no second copy anywhere to fall back on if a call gets it banned. Defaults
# to false if unset.
#WSM_CALLS_ENABLED=false

# ── WhatsApp backend (whatsmeow / waxum) ────────────────────────────────────
# Which transport drives WhatsApp sessions. "waxum" (a Rust REST gateway,
# internal/waxum, driven by internal/wa/backend_waxum.go, deployed as its own
# container by docker-compose.yml) is now the DEFAULT — the app boots no
# whatsmeow SQLite store at all in that mode (see cmd/app/main.go's
# newBackend). "whatsmeow" (in-process, go.mau.fi/whatsmeow) is the rollback
# switch. Anything other than these two values is a boot failure.
#
# CONSEQUENCE OF THE DEFAULT: leaving this unset now means WSM_WAXUM_URL and
# WSM_WAXUM_TOKEN below become REQUIRED — config.Load() fails at boot without
# them. Container mode (`make up`) sets both for you from the vars in this
# section (see docker-compose.yml's `app` service). Host mode does not: set
# WSM_WA_BACKEND=whatsmeow here for `make run`, or fill in WSM_WAXUM_URL/TOKEN
# yourself if you're running waxum outside compose too.
#
# ROLLBACK IS ASYMMETRIC. Flipping this back to "whatsmeow" restores the old
# transport ONLY if no device has paired through waxum yet — once one has,
# its credentials live in waxum's volume (whatsapp-with-dashboard-waxum), not
# whatsmeow's, and rolling back means re-pairing that handset by QR. This flag
# buys a clean rollback before pairing, not after.
WSM_WA_BACKEND=waxum

# REQUIRED when WSM_WA_BACKEND=waxum (the default — see above). Read by
# internal/config. Absolute, scheme required (http:// or https://). In
# container mode docker-compose.yml overrides this to http://waxum:3451 for
# you; the value here is for host mode / running the app outside compose.
#WSM_WAXUM_URL=http://127.0.0.1:9000
# REQUIRED when WSM_WA_BACKEND=waxum. Read by internal/config; sent as
# `Authorization: Bearer …` on every request to waxum. In container mode this
# is docker-compose.yml's WSM_WAXUM_TOKEN, sourced from WAXUM_TOKEN below —
# fill in WAXUM_TOKEN, not this one, unless you're also running the app
# outside compose.
#WSM_WAXUM_TOKEN=

# Optional. Go duration syntax (time.ParseDuration). Read by internal/config;
# resolve to a default regardless of which backend is selected.
#WSM_WAXUM_TIMEOUT=30s
#WSM_WAXUM_QR_POLL_INTERVAL=3s
# 60s, not 15s: with the SSE event pump (below) on by default, this poller is
# a reconciling BACKSTOP, not the primary signal — see
# config.DefaultWaxumPollInterval's doc comment.
#WSM_WAXUM_POLL_INTERVAL=60s
#WSM_WAXUM_PAIR_TIMEOUT=180s

# Optional, boolean, default true. Phase 8: subscribes to waxum's fleet-wide
# GET /api/v1/events/tail Server-Sent-Events stream (internal/wa/
# backend_waxum_events.go) and uses it to "poke" a session's status poller
# awake immediately on a connection-relevant event, instead of waiting up to
# WSM_WAXUM_POLL_INTERVAL. It never sets session state itself — see that
# file's package doc comment for why an event stream must not become a
# second state authority. Set to false to fall back to pure polling, e.g.
# against a waxum build whose event stream is unreachable or unreliable.
#WSM_WAXUM_EVENTS=true

# ── waxum container (compose-only; docker-compose.yml's `waxum` service) ───
# None of the vars below are read by internal/config — they configure the
# waxum PROCESS itself, which docker-compose.yml starts as a separate
# container reachable only at http://waxum:3451 on the compose network (no
# published port; see the service's comment for why).

# Third-party image tag. PINNED, never "latest": an unpinned tag is an
# unreviewed upgrade landing on every `docker compose pull`. 0.12.2 is current
# as of this writing (matches waxum's own Cargo.toml, multi-arch amd64/arm64).
WAXUM_TAG=0.12.2-uploaded-media

# waxum's own rate limiter (tower_governor, RATE_LIMIT_PER_SECOND/
# RATE_LIMIT_BURST) is set directly in docker-compose.yml's `waxum` service,
# not through a var here — those values (a 1-second replenish interval, burst
# 200) are unlikely to need per-deployment tuning, unlike WAXUM_TAG/
# WAXUM_TOKEN above. RATE_LIMIT_PER_SECOND is NOT a requests-per-second rate:
# tower_governor's per_second() is the REPLENISH INTERVAL in seconds for one
# token, so a SMALLER number is more generous, not less — waxum's own
# default of 20 means one token every 20 seconds. See the `waxum` service's
# own comment and CLAUDE.md's waxum rate-limit hazard note for the live
# incident that found it.
#
# Same reasoning for webhook delivery retry/DLQ (Phase 9):
# WEBHOOK_RETRY_MAX_ATTEMPTS/WEBHOOK_DLQ_CAPACITY are also waxum-PROCESS
# settings, also set directly in docker-compose.yml's `waxum` service, not
# through a var here.

# waxum's SUPERADMIN_TOKEN: a ROOT credential for EVERY WhatsApp session that
# process holds, compared in constant time and bypassing JWT entirely. Same
# handling as _data/paswd or _data/database-cred.json — generate it, never
# echo it, never commit a real value here.
#   openssl rand -hex 32
# This same value also becomes the app's WSM_WAXUM_TOKEN in container mode
# (docker-compose.yml wires WSM_WAXUM_TOKEN: ${WAXUM_TOKEN} on the `app`
# service), so the app and waxum agree on one secret without it being typed
# twice.
WAXUM_TOKEN=

# waxum's own MySQL database, on the SAME shared master-compose-ai stack the
# app's tables live on (a separate schema — house rule: one schema + one
# least-privilege user per product). Bootstrap once with `make
# db-bootstrap-waxum` (reuses scripts/bootstrap-db.sql.tmpl, unchanged).
WAXUM_MYSQL_USER=waxum
# Generate with:  openssl rand -hex 12  (HEX ONLY — see WSM_MYSQL_PASSWORD's
# comment above; the same sed substitution applies).
WAXUM_MYSQL_PASSWORD=
WAXUM_MYSQL_DATABASE=waxum
