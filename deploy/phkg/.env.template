# whatsapp-with-dashboard — .env for wa-phkg. Copy to `.env` beside
# docker-compose.yml and fill every line marked ISI.
#
#   cp .env.template .env && chmod 600 .env
#
# THREE KINDS OF LINE LIVE HERE, and the difference matters:
#
#   ISI      — deliberately EMPTY. docker-compose.yml guards each of these with
#              `${VAR:?...}`, so `docker compose up` refuses to start rather
#              than booting against a half-configured deployment. Leave it
#              empty until you have the real value; an empty line here is a
#              loud failure, a wrong one is a silent misconfiguration.
#   PHKG     — operational values chosen for THIS host.
#   PROD     — non-secret values carried over from the production deployment.
#
# NO PRODUCTION SECRET IS COPIED INTO THIS FILE. WAXUM_TOKEN, the database
# passwords, the MinIO keys and the admin hash are all generated fresh for
# PHKG. Reusing production's WAXUM_TOKEN in particular would hand this host a
# root credential for every session on the production waxum instance.

# ─── ISI: MySQL (menyusul) ────────────────────────────────────────────────────
# The app store. The database and a least-privilege user must already exist —
# see bootstrap-db.sql.tmpl — and the schema must be migrated before the app is
# useful. The binary never migrates on boot.
WSM_MYSQL_HOST=
WSM_MYSQL_PORT=
WSM_MYSQL_USER=
WSM_MYSQL_PASSWORD=
WSM_MYSQL_DATABASE=

# waxum keeps its own registry in a SEPARATE schema on the same server, with
# its own least-privilege user. Same host/port as above — waxum takes one DSN,
# assembled in docker-compose.yml from WSM_MYSQL_HOST/PORT plus these three.
WAXUM_MYSQL_USER=
WAXUM_MYSQL_PASSWORD=
WAXUM_MYSQL_DATABASE=

# ─── ISI: MinIO (menyusul) ────────────────────────────────────────────────────
# NOT OPTIONAL, and not merely a config requirement: boot performs a LIVE
# network check. internal/config rejects an empty endpoint/key/secret/bucket,
# and cmd/app then calls storage.EnsureBuckets before serving anything. An
# unreachable MinIO or a wrong credential is log.Fatalf, not a degraded mode.
# WSM_MEDIA_ARCHIVE=false only skips the archive STEP at runtime; it does not
# relax this.
#
# The buckets themselves need not pre-exist — EnsureBuckets creates whichever
# is missing — but the credential must be allowed to create them.
WSM_MINIO_ENDPOINT=
WSM_MINIO_ACCESS_KEY=
WSM_MINIO_SECRET_KEY=
WSM_MINIO_BUCKET=

# ─── ISI: kredensial yang dibuat baru untuk PHKG ─────────────────────────────
# A root credential for every WhatsApp session on this waxum instance, compared
# in constant time and bypassing JWT entirely. Generate a long random string
# (`openssl rand -hex 32`), never echo it, never commit it.
WAXUM_TOKEN=

# Dashboard login. The hash is bcrypt; generate it on a machine that has the
# repo and a Go toolchain — wa-phkg has neither, and the app image is
# distroless, so there is no hashpw binary inside it either:
#
#   go run ./cmd/hashpw          # reads stdin, never argv
#
# KEEP THE SINGLE QUOTES. A bcrypt hash is `$2a$10$…`, and compose interpolates
# `$` in an unquoted .env value; single quotes make it literal.
WSM_ADMIN_USER=
WSM_ADMIN_PASSWORD_HASH=''

# ─── PHKG: bagaimana host ini diekspos ───────────────────────────────────────
# wa-phkg has no reverse proxy and no TLS. Loopback only; reach the dashboard
# over an SSH tunnel:
#
#   ssh -L 18801:127.0.0.1:18801 wa-phkg
#
# Opening this to the LAN means putting an admin surface with a WhatsApp
# identity behind it on the network in plaintext. If a proxy is added later,
# set WSM_BIND_ADDR to the ONE interface it reaches this box on (never
# 0.0.0.0), flip WA_COOKIE_SECURE to true, set WA_BASE_URL to the https URL,
# and list the proxy in WSM_TRUSTED_PROXIES.
WSM_BIND_ADDR=127.0.0.1
WSM_EXPOSED_PORT=18801
WSM_ADDR=:8800
WA_BASE_URL=http://localhost:18801
# Must stay false while the dashboard is plain HTTP: a Secure cookie is never
# stored over http://, so login silently never sticks.
WA_COOKIE_SECURE=false
WSM_TRUSTED_PROXIES=
WA_PLATFORM_URL=

# The crypto store path INSIDE the container, on the wsm-sqlite volume.
WSM_DB_PATH=/data/wsm.db
# Must be `sqlite` (pure-Go modernc driver). `sqlite3` is the old CGO driver
# and is rejected at boot.
WSM_SQLITE_DIALECT=sqlite

# ─── PROD: nilai non-rahasia yang dibawa dari produksi ───────────────────────
WAXUM_TAG=0.12.2-uploaded-media
WSM_SESSION_TTL=12h
WSM_SEND_RATE=1.0
WSM_SEND_BURST=3
WSM_RECONCILE_PAR=4
WSM_DARK_MODE=true
# PRODUCT-SCOPED ON PURPOSE, and this line must never be reverted to the bare
# `temp` that config.DefaultMinioTempBucket falls back to. Since 2026-09-02 this
# deployment's MinIO is 192.168.20.12:9000, which is SHARED with other products
# — and `temp` is a real bucket there, holding 19,784 objects belonging to
# someone else at the time of the cutover. Worse, WSM_MINIO_ACCESS_KEY on this
# host is a MinIO ADMIN key, so a fallback to the default would not just mingle
# WhatsApp temp media into another product's bucket, it would do so with a
# credential that can delete what is already in it. EnsureBuckets creates
# whatever is named here, so a scoped name costs nothing.
WSM_MINIO_TEMP_BUCKET=whatsapp-phkg-temp
WSM_MINIO_TIMEOUT=100s
WSM_MINIO_SHARE_DURATION=168h
# 100 MiB. If an nginx (or any edge) is ever put in front of this app, its
# client_max_body_size must be set ABOVE this number — nginx's own default is
# 1 MiB and it answers a bare 413 BEFORE proxying, so the app logs nothing and
# writes no wa_messages row, and the failure reads as "the app ignored my
# upload". Production found this the hard way with a 1.6 MB video.
WSM_MEDIA_MAX_BYTES=104857600
WSM_MEDIA_UPLOAD_CONCURRENCY=2
# Automated outbound calling risks a ban on a paired device identity that has
# no second copy anywhere. Opt in deliberately or every /calls/* endpoint
# answers 501 and says so.
WSM_CALLS_ENABLED=false
